rules_version = '2';

// Regras do Firestore da Pauta — modelo "escritório + convites".
// Quem cria o escritório vira administrador. Administradores convidam pelo e-mail Google.
// Só quem está na lista "membros" do escritório lê ou grava os dados dele.
// Cole em: Firebase Console → Firestore Database → Regras → Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() {
      return request.auth.token.email.lower();
    }
    function esc(eid) {
      return get(/databases/$(database)/documents/escritorios/$(eid)).data;
    }
    function membro(eid) {
      return logado() && exists(/databases/$(database)/documents/escritorios/$(eid)) && meuEmail() in esc(eid).membros;
    }
    function admin(eid) {
      return logado() && exists(/databases/$(database)/documents/escritorios/$(eid)) && meuEmail() in esc(eid).admins;
    }

    match /escritorios/{eid} {
      allow get: if logado() && meuEmail() in resource.data.membros;
      allow create: if logado()
        && request.resource.data.donoUid == request.auth.uid
        && request.resource.data.donoEmail == meuEmail()
        && request.resource.data.membros == [meuEmail()]
        && request.resource.data.admins == [meuEmail()];
      // Só administradores alteram; o dono nunca sai da lista nem perde o admin.
      allow update: if logado() && meuEmail() in resource.data.admins
        && request.resource.data.donoUid == resource.data.donoUid
        && request.resource.data.donoEmail == resource.data.donoEmail
        && resource.data.donoEmail in request.resource.data.membros
        && resource.data.donoEmail in request.resource.data.admins;
      allow delete: if false;

      match /{colecao}/{id} {
        allow read, write: if colecao in ['equipe', 'casos', 'agenda', 'mensagens'] && membro(eid);
      }
    }

    // convites/{email} → { eid }: diz a cada pessoa em qual escritório ela entra.
    match /convites/{email} {
      allow get: if logado() && email == meuEmail();
      allow create: if logado() && admin(request.resource.data.eid);
      allow update: if logado() && admin(resource.data.eid) && admin(request.resource.data.eid);
      allow delete: if logado() && (email == meuEmail() || admin(resource.data.eid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
